BOT_TOKEN=put-your-bot-token-here
# Supabase -> Connect -> "Session pooler" connection string (IPv4 compatible)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
MIN_STARS=1
MAX_STARS=10000
# Clearly labelled "sample entry" row on an (almost) empty board. 0 = off.
SHOW_SAMPLE_ROW=1
SAMPLE_STARS=100
FOUNDING_LIMIT=50
